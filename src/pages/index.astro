---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/paths';
import { formatDate } from '../lib/format';

const lectures = await getCollection('lectures');
const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Memento" subtitle="講義ノート集">
  <div class="card-grid">
    {
      notes.map((note) => {
        const lectureSlug = note.id.split('/')[0];
        const noteSlug = note.id.split('/')[1];
        const lecture = lectures.find((l) => l.id === lectureSlug);
        return (
          <a class="card" href={withBase(`lectures/${lectureSlug}/${noteSlug}/`)}>
            <div class="card-header">
              <span class={`badge ${lecture?.data.subject}`}>{lecture?.data.title}</span>
              <time datetime={note.data.date.toISOString().slice(0, 10)}>
                {formatDate(note.data.date)}
              </time>
            </div>
            <h2 class="card-title">{note.data.title}</h2>
            <p class="card-excerpt">{note.data.excerpt}</p>
          </a>
        );
      })
    }
  </div>
</Layout>
